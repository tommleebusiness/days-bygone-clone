# Android build artifacts
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/*.keystore

# Node / tooling
node_modules/
.gradle/
*.log

# OS
Thumbs.db
.DS_Store

# Local helper scripts
_patch_*.py
_tmp_*.js

# pixelfx — внешняя библиотека (github.com/patch-gg/pixelfx).
# Игра использует вендорную копию: days-bygone-clone/game/vendor/pixelfx/
pixelfx/
# assets генерируются gradle-задачей copyGameAssets при сборке
android/app/src/main/assets/game/

# Рендер-стенды (генерируются node _render.mjs / _tiers.mjs)
_render/

# Старые сборки в корне (актуальные лежат в dist/)
/days-bygone-*.apk

# Временные исходники стендов
store/**/_raw*
